<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- اندروید ۱۵: edge-to-edge خاموش. اندروید ۱۶+ این گزینه را نادیده می‌گیرد و SystemBars.java فاصله‌ها را تنظیم می‌کند.
         (استایل‌های مشترک مثل SectionTitle در values/themes.xml هستند و اینجا هم در دسترس‌اند) -->
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="BreakTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#064E3B</item>
        <item name="android:navigationBarColor">#0F766E</item>
        <item name="android:windowBackground">@drawable/bg_break_screen</item>
        <item name="android:colorAccent">#A7F3D0</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="BlockedTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#1E1B4B</item>
        <item name="android:navigationBarColor">#312E81</item>
        <item name="android:windowBackground">@drawable/bg_blocked_screen</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
