<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- کارت وضعیت -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_off"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_blocked_circle"
                android:gravity="center"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/toggleBtn"
            style="@style/StatusButton"
            android:layout_marginTop="18dp" />

        <Button
            android:id="@+id/pauseBtn"
            style="@style/StatusButton"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- هشدار سرویس خاموش -->
    <TextView
        android:id="@+id/accWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_warning"
        android:padding="12dp"
        android:text="@string/acc_warning"
        android:textColor="@color/warning_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- سهمیه روزانه -->
    <TextView
        style="@style/SectionTitle"
        android:text="@string/section_limit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/limit_title"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/limit_sub"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/limitSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/limitProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progressBackgroundTint="@color/primary_soft"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/limitUsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/limit_per_day"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/limitVal"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text" />

            <Spinner
                android:id="@+id/limitUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/limitP15"
                    style="@style/Chip"
                    android:text="@string/limit_p15" />

                <TextView
                    android:id="@+id/limitP30"
                    style="@style/Chip"
                    android:text="@string/limit_p30" />

                <TextView
                    android:id="@+id/limitP60"
                    style="@style/Chip"
                    android:text="@string/limit_p60" />

                <TextView
                    android:id="@+id/limitP120"
                    style="@style/Chip"
                    android:text="@string/limit_p120" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/limitSave"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/save" />
    </LinearLayout>

    <!-- راه‌اندازی -->
    <TextView
        style="@style/SectionTitle"
        android:text="@string/section_setup" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="1dp">

        <include
            android:id="@+id/rowAcc"
            layout="@layout/row_setup" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="70dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/rowAdmin"
            layout="@layout/row_setup" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="70dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/rowFw"
            layout="@layout/row_setup" />
    </LinearLayout>

    <!-- محافظت -->
    <TextView
        style="@style/SectionTitle"
        android:text="@string/section_protection" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protect_title"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/protect_sub"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/protectSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- لیست اپ‌ها -->
    <TextView
        android:id="@+id/appsHeader"
        style="@style/SectionTitle" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_faint"
        android:textSize="15sp" />
</LinearLayout>
