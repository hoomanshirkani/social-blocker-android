<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <!-- کارت وضعیت فایروال -->
    <LinearLayout
        android:id="@+id/fwCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_off"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/fwIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_blocked_circle"
            android:gravity="center"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fwTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fwSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/fwSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- زمان‌بندی -->
    <TextView
        style="@style/SectionTitle"
        android:text="@string/fw_sched_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fw_sched_enable"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/fw_sched_sub"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/schedSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fw_allow_for"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/onVal"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text" />

            <Spinner
                android:id="@+id/onUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="@string/fw_every"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/everyVal"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text" />

            <Spinner
                android:id="@+id/everyUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/fw_presets"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preset1"
                    style="@style/Chip"
                    android:text="@string/preset_1" />

                <TextView
                    android:id="@+id/preset2"
                    style="@style/Chip"
                    android:text="@string/preset_2" />

                <TextView
                    android:id="@+id/preset3"
                    style="@style/Chip"
                    android:text="@string/preset_3" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/saveSched"
            style="@style/PrimaryButton"
            android:layout_marginTop="16dp"
            android:text="@string/fw_save_sched" />
    </LinearLayout>

    <!-- لیست اپ‌ها -->
    <TextView
        android:id="@+id/fwAppsHeader"
        style="@style/SectionTitle" />

    <EditText
        android:id="@+id/fwSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text_faint"
        android:textSize="15sp" />
</LinearLayout>
