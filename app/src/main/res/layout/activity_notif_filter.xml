<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/nfSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nf_switch"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nf_desc"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nfAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_warning"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:text="@string/digest_access_needed"
            android:textColor="@color/warning_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/nfSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nf_sound"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nf_sound_desc"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nfMuteApp"
            style="@style/Chip"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="0dp"
            android:text="@string/nf_mute_app" />
    </LinearLayout>

    <TextView
        android:id="@+id/nfAdd"
        style="@style/Chip"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="0dp"
        android:text="@string/nf_add_app" />

    <TextView
        style="@style/SectionTitle"
        android:text="@string/nf_rules_header" />

    <ListView
        android:id="@+id/nfList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>
